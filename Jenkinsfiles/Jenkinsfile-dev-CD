pipeline {
    agent { label 'windows' }


    environment {
        REPO_URL = 'https://github.com/DipHuy/HCMUS-Intro_DevOps-spring-petclinic-microservices.git'
        GITOPS_REPO_URL = 'github.com/DipHuy/HCMUS-Intro_DevOps-gitops-spring-petclinic-microservices.git'
        GITHUB_CREDENTIALS_ID = 'PAT_Github_Intro_DevOps'
        HELM_DIR = 'Helm'
        DEV_VALUES_FILE = 'values-dev.yaml'
        JENKIN_URL = "https://jenkins.diephuy.dpdns.org/"
    }


    stages {
        stage('Checkout gitops repo') {
            steps {
                dir('gitops') {
                    git(
                        url: "https://${env.GITOPS_REPO_URL}",
                        branch: 'main',
                        credentialsId: 'PAT_Github_Intro_DevOps'
                    )
                }
            }
        }

        stage('Update dev values') {
            steps {
                dir('gitops') {
                    script {
                        def rawOutput = bat(
                            script: '@echo off & git ls-remote ' + env.REPO_URL + ' refs/heads/main', 
                            returnStdout: true
                        ).trim()

                        def targetLine = rawOutput.readLines().find { it.contains('refs/heads/main') }

                        if (!targetLine) {
                            error("Not found:\n${rawOutput}")
                        }

                        def tag = targetLine.trim().split('\\s+')[0]
                        echo "Tag resolved: ${tag}"

                        def valuesFilePath = "${HELM_DIR}/${DEV_VALUES_FILE}"
                        def valuesContent = readFile(file: valuesFilePath)

                        def updatedContent = valuesContent.replaceAll(/tag:\s*.*/, "tag: ${tag}")

                        writeFile(file: valuesFilePath, text: updatedContent)
                        echo "Updated ${valuesFilePath} with image tag: ${tag}"
                    }
                }
            }
        }

        stage('Commit and push change') {
            steps {
                dir('gitops') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: "${GITHUB_CREDENTIALS_ID}",
                            usernameVariable: 'USERNAME',
                            passwordVariable: 'PASSWORD'
                        )
                     ]) {
                        script {
                        bat """
                              git config user.name "Jenkins"
                              git config user.email "jenkins@example.com"

                              git add .
                              git commit -m "Update dev values with build_ID ${env.BUILD_ID}" || exit 0
                              git push https://${USERNAME}:${PASSWORD}@${env.GITOPS_REPO_URL} HEAD:main
                        """

                          
                        }
                     }
                }
            }
        }
    }   
}
