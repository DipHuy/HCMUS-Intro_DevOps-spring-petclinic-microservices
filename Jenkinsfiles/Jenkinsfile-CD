pipeline {
    agent { label 'windows' }

    parameters {
        string(name: 'discovery-server', defaultValue: 'main')
        string(name: 'config-server', defaultValue: 'main')
        string(name: 'api-gateway', defaultValue: 'main')
        string(name: 'customers-service', defaultValue: 'main')
        string(name: 'genai-service', defaultValue: 'main')
        string(name: 'vets-service', defaultValue: 'main')
        string(name: 'visits-service', defaultValue: 'main')
    }

    environment {
        REPO_URL = 'https://github.com/DipHuy/spring-petclinic-microservices.git'
        IMAGE_NAME = 'diphuy/spring-petclinic'
        HELM_DIR = 'Helm'
        NAMESPACE = "dev-${BUILD_ID}"
        DOMAIN = "${NAMESPACE}.com"
        JENKIN_URL = "https://jenkins.diephuy.dpdns.org/"
    }

    

    stages {
        stage('Prepare services') {
            steps {
                script {
                    first_services = [
                        [name: 'discovery-server', branch: params['discovery-server'], port: 8761, nodePort: 30061],
                        [name: 'config-server', branch: params['config-server'], port: 8888, nodePort: 30088],
                    ]
                    services = [
                        [name: 'admin-server', branch: params['admin-server'], port: 9090, nodePort: 30090],
                        [name: 'api-gateway', branch: params['api-gateway'], port: 8080, nodePort: 30080],

                        // random port
                        [name: 'customers-service', branch: params['customers-service'], port: 8081, nodePort: 30081],
                        [name: 'visits-service', branch: params['visits-service'], port: 8082, nodePort: 30082],
                        [name: 'vets-service', branch: params['vets-service'], port: 8083, nodePort: 30083],
                        [name: 'genai-service', branch: params['genai-service'], port: 8084, nodePort: 30084]
                    ]
                        
                    tags = []
                    for (service in first_services) {
                        def commitID = bat(script: "git ls-remote ${REPO_URL} refs/heads/${service.branch}", returnStdout: true).trim()
                        def parts = commitID.split('\\s+')
                        
                        if (parts.size() <= 0 || !parts[0]) {
                            error "Failed to retrieve commit ID for branch ${service.branch}"
                        }
                        
                        def tag = parts[0].trim()
                        tags.add(tag)
                        echo "tag for ${service.name} (${service.branch}): ${tag}"
                    }

                    for (service in services) {

                        def commitID = bat(script: "git ls-remote ${REPO_URL} refs/heads/${service.branch}", returnStdout: true).trim()
                        def parts = commitID.split('\\s+')
                        
                        if (parts.size() <= 0 || !parts[0]) {
                            error "Failed to retrieve commit ID for branch ${service.branch}"
                        }
                        
                        def tag = parts[0].trim()
                        
                        

                        tags.add(tag)
                        echo "tag for ${service.name} (${service.branch}): ${tag}"
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([file(credentialsId: "Intro_DevOps_Kubeconfig", variable: 'KUBECONFIG')]) {
                    script {
                        // Create the namespace if it doesn't exist
                        bat '''
                            kubectl create namespace %NAMESPACE% --dry-run=client -o yaml | kubectl apply -f -
                        '''

                        for (int i = 0; i < first_services.size(); ++i) {
                            def service = first_services[i]
                            def tag = tags[i]
                            def image = "${IMAGE_NAME}-${service.name}:${tag}"

                            bat """
                                helm upgrade --install ${service.name} ${HELM_DIR} --set name=${service.name} --set image.repository=${IMAGE_NAME}-${service.name} --set image.tag=${tag} --set service.port=${service.port} --set service.nodePort=${service.nodePort} --namespace ${NAMESPACE} --wait --timeout 300s
                            """
                        }

                        // Deploy each service using Helm
                        for (int i = 0; i < services.size(); ++i) {
                            def service = services[i]
                            def tag = tags[i]
                            def image = "${IMAGE_NAME}-${service.name}:${tag}"

                            bat """
                                helm upgrade --install ${service.name} ${HELM_DIR} --set name=${service.name} --set image.repository=${IMAGE_NAME}-${service.name} --set image.tag=${tag} --set service.port=${service.port} --set service.nodePort=${service.nodePort} --namespace ${NAMESPACE}
                            """
                        }
                    }
                }
                
            }
        }

        stage('Print out URL') {
            steps {
                withCredentials([string(credentialsId: 'Intro_DevOps_CleanUp_Auth_Token', variable: 'AUTH_TOKEN')]) {
                script {
                    def cleanupJobUrl = "${JENKIN_URL}job/Clean_Up_Deployment/buildWithParameters?token=${AUTH_TOKEN}&namespace=${NAMESPACE}" 
                    
                    echo "Access the application at: http://${DOMAIN}:30080"
                    echo "To clean up the deployment, run the cleanup job at: ${cleanupJobUrl}"


                    currentBuild.description = """
                        <div>
                            <b>Deployment URL:</b> <a href='http://${DOMAIN}:30080' target='_blank'>http://${DOMAIN}:30080</a><br/>
                            <b>Cleanup:</b> <a href="${cleanupJobUrl}" target='_blank'>Click here to delete deployment</a>
                        </div>
                    """.stripIndent()
                }
            }
        }
        }
        
    }   
}
