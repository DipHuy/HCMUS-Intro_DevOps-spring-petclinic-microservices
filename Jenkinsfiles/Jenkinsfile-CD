pipeline {
    agent { label 'windows' }

    parameters {
        string(name: 'eureka-services', defaultValue: 'main')
        string(name: 'admin-server', defaultValue: 'main')
        string(name: 'zipkin', defaultValue: 'main')
        string(name: 'api-gateway', defaultValue: 'main')
        string(name: 'customers-services', defaultValue: 'main')
        string(name: 'genai-services', defaultValue: 'main')
        string(name: 'vets-services', defaultValue: 'main')
        string(name: 'visits-services', defaultValue: 'main')
    }

    environment {
        REPO_URL = 'https://github.com/DipHuy/spring-petclinic-microservices.git'
        IMAGE_NAME = 'diphuy'
    }

    

    stages {
        stage('Prepare services') {
            steps {
                script {
                    services = [
                        [name: 'eureka-services', branch: params.['eureka-services'], port: 8761],
                        [name: 'admin-server', branch: params.['admin-server'], port: 9090],
                        [name: 'zipkin', branch: params.['zipkin'], port: 9411],
                        [name: 'api-gateway', branch: params.['api-gateway'], port: 8080],
                        [name: 'customers-services', branch: params.['customers-services'], port: 8081],
                        [name: 'visits-services', branch: params.['visits-services'], port: 8082],
                        [name: 'vets-services', branch: params.['vets-services'], port: 8083],
                        [name: 'genai-services', branch: params.['genai-services'], port: 8084]
                    ]
                        
                    tags = []
                    for (service in services) {
                        def tag = 'latest'

                        if (service.branch != 'main') {
                            def commitID = bat(script: "git ls-remote ${REPO_URL} refs/heads/${service.branch}", returnStdout: true).trim()
                            def parts = commitID.split('\\s+')
                            
                            if (parts.size() > 0 && parts[0]) {
                                tag = parts[0].trim()
                            }
                            else {
                                error "Failed to retrieve commit ID for branch ${service.branch}"
                            }
                        }

                        tags.append(tag)
                        echo "tag for ${service.name}: ${tag}"
                    }
                }
            }
        }
        
    }   
}
