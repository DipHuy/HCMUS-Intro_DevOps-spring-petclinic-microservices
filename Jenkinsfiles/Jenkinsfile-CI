pipeline {
    agent { label 'windows' }

    environment {
        DOCKERHUB_CREDENTIALS_ID = 'PAT_Dockerhub_Intro_DevOps'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }


        stage('Get Image Tag') {
            steps {
                script {

                    if (env.TAG_NAME?.trim()) {

                        env.IMAGE_TAG = env.TAG_NAME
                        env.BUILD_TYPE = "staging"

                    } else {

                        env.IMAGE_TAG = env.GIT_COMMIT ?: bat(
                            script: 'git rev-parse HEAD',
                            returnStdout: true
                        ).trim()

                        env.BUILD_TYPE = "dev"
                    }

                    echo "Build type : ${env.BUILD_TYPE}"
                    echo "Branch     : ${env.BRANCH_NAME}"
                    echo "Git Tag    : ${env.TAG_NAME}"
                    echo "Image Tag  : ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Validate Release Tag') {
            when {
                expression { return env.TAG_NAME }
            }

            steps {
                checkout scm

                bat 'git fetch origin main --tags'

                script {
                    def status = bat(
                        script: """
                            git merge-base --is-ancestor %TAG_NAME% origin/main
                        """,
                        returnStatus: true
                    )

                    if (status != 0) {
                        error "Tag ${env.TAG_NAME} is not a descendant of branch main!"
                    }

                    echo "Valid release tag: ${env.TAG_NAME}"
                }
            }
        }


        stage('Build and Push Docker Image') {
            steps {
                script {
                    withCredentials([
                        usernamePassword(
                            credentialsId: "${DOCKERHUB_CREDENTIALS_ID}",
                            usernameVariable: 'DOCKER_USERNAME',
                            passwordVariable: 'DOCKER_PASSWORD'
                        )
                     ])  {
                        try {

                            bat """
                            echo %DOCKER_PASSWORD%| docker login -u %DOCKER_USERNAME% --password-stdin
                            """
                            
                            def imageTag = env.IMAGE_TAG


                            def mvnCommand = "./mvnw.cmd clean install -P buildDocker -DskipTests " + "-Ddocker.image.prefix=${env.DOCKER_USERNAME} " + "-Ddocker.image.tag.commit=${imageTag} " + "-Dcontainer.build.extraarg=\"--push\""

                            echo "Executing Maven command: ${mvnCommand}"
                            bat mvnCommand

                            echo "Docker image built successfully"
                        } catch (Exception e) {
                            echo "Error during Docker build or push: ${e.getMessage()}"
                            error(message: "Failed to build images via Maven")

                        }
                    }
                    
                    
                }
            }
        }

        stage('Trigger Staging Deployment') {
            when {
                expression { return env.BUILD_TYPE == "staging" && env.TAG_NAME?.trim() }
            }

            steps {
                build job: 'CD-staging', parameters: [
                    string(name: 'TAG_NAME', value: env.TAG_NAME),
                ]
            }
        }
    }

    post {
        success {
            echo "Docker image pushed successfully:"


        }

        failure {
            echo "Build or Docker push failed."
        }

        always {
            bat """
                docker image prune -f
            """
        }
    }
}

